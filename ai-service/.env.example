# App Configuration
APP_NAME="Aurevia AI Service"
VERSION="0.1.0"
ENVIRONMENT="development"

# API Settings
API_V1_STR="/api/v1"

# MinIO (Optional)
STORAGE_PROVIDER=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET_NAME=aurevia-audio
MINIO_SECURE=false

# --- Phase 4 AI Settings ---
AI_MODE=demo
AI_DEVICE=cpu
NLP_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
STT_MODEL_NAME=openai/whisper-tiny

# CORS
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:8000", "http://localhost:3000"]

# Demo Mode (If true, use mock AI responses)
DEMO_MODE=True
